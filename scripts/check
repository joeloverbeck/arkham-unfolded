#!/usr/bin/env bash
set -euo pipefail

cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."

python3 -B scripts/check_tracked_files.py
python3 -B -m unittest discover -s scripts -p 'test_*.py'
cargo fmt --all -- --check
cargo clippy --locked --features tabletop --all-targets -- -D warnings
cargo test --locked --features tabletop
